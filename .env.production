# Production Environment Configuration
REACT_APP_ENV=production
REACT_APP_API_BASE_URL=https://api.yourcompany.com/api
REACT_APP_API_TIMEOUT=20000
REACT_APP_APP_NAME=Enterprise React App
REACT_APP_VERSION=1.0.0

# Debug Settings
REACT_APP_LOG_LEVEL=error
REACT_APP_DEBUG_MODE=false
REACT_APP_ENABLE_REDUX_DEVTOOLS=false
REACT_APP_ENABLE_REACT_QUERY_DEVTOOLS=false

# Feature Flags
REACT_APP_FEATURE_NEW_DASHBOARD=true
REACT_APP_FEATURE_ANALYTICS=true
REACT_APP_FEATURE_BETA_FEATURES=false

# Third-party Services (Production)
REACT_APP_SENTRY_DSN=https://your-production-sentry-dsn@sentry.io/project-id
REACT_APP_POSTHOG_KEY=your-production-posthog-key
REACT_APP_POSTHOG_HOST=https://app.posthog.com

# Mock API
REACT_APP_MOCK_API=false

# Security
REACT_APP_CSP_ENABLED=true