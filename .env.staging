# Staging Environment Configuration
REACT_APP_ENV=staging
REACT_APP_API_BASE_URL=https://api-staging.yourcompany.com/api
REACT_APP_API_TIMEOUT=15000
REACT_APP_APP_NAME=Enterprise React App (Staging)
REACT_APP_VERSION=1.0.0

# Debug Settings
REACT_APP_LOG_LEVEL=warn
REACT_APP_DEBUG_MODE=false
REACT_APP_ENABLE_REDUX_DEVTOOLS=false
REACT_APP_ENABLE_REACT_QUERY_DEVTOOLS=false

# Feature Flags
REACT_APP_FEATURE_NEW_DASHBOARD=true
REACT_APP_FEATURE_ANALYTICS=true
REACT_APP_FEATURE_BETA_FEATURES=true

# Third-party Services (Staging)
REACT_APP_SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id
REACT_APP_POSTHOG_KEY=your-staging-posthog-key
REACT_APP_POSTHOG_HOST=https://app.posthog.com

# Mock API
REACT_APP_MOCK_API=false

# Security
REACT_APP_CSP_ENABLED=true