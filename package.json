{
  "name": "enterprise-react-app",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade React application with TypeScript, Redux, MUI, and comprehensive tooling",
  "keywords": [
    "react",
    "typescript",
    "enterprise",
    "redux-toolkit",
    "mui",
    "react-query",
    "i18n",
    "accessibility"
  ],
  "author": "Your Company <dev@yourcompany.com>",
  "license": "MIT",
  "homepage": ".",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.1",
    "@mui/lab": "^5.0.0-alpha.157",
    "@mui/material": "^5.15.1",
    "@mui/x-data-grid": "^6.18.3",
    "@mui/x-date-pickers": "^6.18.3",
    "@reduxjs/toolkit": "^2.0.1",
    "@sentry/react": "^7.87.0",
    "@sentry/tracing": "^7.87.0",
    "@tanstack/react-query": "^5.15.5",
    "@tanstack/react-query-devtools": "^5.15.5",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "ag-grid-community": "^31.0.3",
    "ag-grid-react": "^31.0.3",
    "ag-grid-enterprise": "^31.0.3",
    "d3": "^7.8.5",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "formik": "^2.4.5",
    "framer-motion": "^10.16.16",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.0",
    "posthog-js": "^1.96.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "react-window": "^1.8.8",
    "react-window-infinite-loader": "^1.0.9",
    "recharts": "^2.8.0",
    "typescript": "^4.9.5",
    "web-vitals": "^3.5.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@types/yup": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "msw": "^2.0.11",
    "prettier": "^3.1.0",
    "serve": "^14.2.1",
    "source-map-explorer": "^2.5.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "sass-loader": "^13.3.2",
    "postcss-loader": "^7.3.3",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "terser-webpack-plugin": "^5.3.9",
    "compression-webpack-plugin": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "workbox-webpack-plugin": "^7.0.0",
    "webpack-bundle-analyzer": "^4.9.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-imports": "^15.16.7",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "sass": "^1.69.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:prod": "serve -s build -l 3000",
    "build": "react-scripts build",
    "build:staging": "cross-env REACT_APP_ENV=staging npm run build",
    "build:production": "cross-env REACT_APP_ENV=production npm run build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "CI=true react-scripts test --coverage --watchAll=false --testResultsProcessor=jest-sonar-reporter",
    "test:debug": "react-scripts --inspect-brk test --runInBand --no-cache",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:ci": "eslint src --ext .ts,.tsx --format=json --output-file=reports/eslint-report.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"public/**/*.{html,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"public/**/*.{html,json}\" \"*.{js,json,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "setup:folders": "node scripts/setup-folders.js",
    "setup:folders-sh": "chmod +x setup-folders.sh && ./setup-folders.sh",
    "setup:husky": "husky install",
    "setup:complete": "npm run setup:folders && npm run setup:husky && npm run format",
    "clean": "rm -rf build node_modules package-lock.json && npm install",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "pre-commit": "lint-staged",
    "pre-push": "npm run type-check && npm run test:ci",
    "start:webpack": "webpack serve --config webpack.dev.js",
    "build:webpack": "webpack --config webpack.prod.js",
    "build:analyze": "webpack --config webpack.analyze.js",
    "build:dev": "webpack --config webpack.dev.js",
    "clean:build": "rimraf build && webpack --config webpack.prod.js"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie <= 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check && npm run test:ci"
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/reportWebVitals.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "msw": {
    "workerDirectory": "public"
  }
}
