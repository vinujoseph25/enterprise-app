{
  "name": "enterprise-react-app",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade React application with TypeScript, Redux, MUI, and comprehensive tooling",
  "keywords": [
    "react",
    "typescript",
    "enterprise",
    "redux-toolkit",
    "mui",
    "react-query",
    "i18n",
    "accessibility"
  ],
  "author": "Your Company <dev@yourcompany.com>",
  "license": "MIT",
  "homepage": ".",
  "bugs": {
    "url": "https://github.com/your-org/enterprise-react-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/enterprise-react-app.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.1",
    "@mui/lab": "^5.0.0-alpha.157",
    "@mui/material": "^5.15.1",
    "@mui/x-data-grid": "^6.18.3",
    "@mui/x-date-pickers": "^6.18.3",
    "@reduxjs/toolkit": "^2.0.1",
    "@sentry/react": "^7.87.0",
    "@sentry/tracing": "^7.87.0",
    "@tanstack/react-query": "^5.15.5",
    "@tanstack/react-query-devtools": "^5.15.5",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "ag-grid-community": "^31.0.3",
    "ag-grid-react": "^31.0.3",
    "ag-grid-enterprise": "^31.0.3",
    "clsx": "^2.1.0",
    "d3": "^7.8.5",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "formik": "^2.4.5",
    "framer-motion": "^10.16.16",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.5.0",
    "posthog-js": "^1.96.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-helmet-async": "^2.0.4",
    "react-i18next": "^13.5.0",
    "react-redux": "^9.0.4",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "react-window": "^1.8.8",
    "react-window-infinite-loader": "^1.0.9",
    "recharts": "^2.8.0",
    "typescript": "^4.9.5",
    "use-debounce": "^10.0.0",
    "web-vitals": "^3.5.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-imports": "^15.16.7",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/d3": "^7.4.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-window": "^1.8.8",
    "@types/react-window-infinite-loader": "^1.0.9",
    "@types/yup": "^0.32.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^2.1.0",
    "eslint-plugin-sonarjs": "^0.23.0",
    "html-webpack-plugin": "^5.5.3",
    "husky": "^8.0.3",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^15.2.0",
    "mini-css-extract-plugin": "^2.7.6",
    "msw": "^2.0.11",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "serve": "^14.2.1",
    "source-map-explorer": "^2.5.3",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "scripts": {
    "dev": "react-scripts start",
    "start": "react-scripts start",
    "start:prod": "serve -s build -l 3000",
    "start:https": "HTTPS=true react-scripts start",
    "build": "react-scripts build",
    "build:staging": "cross-env REACT_APP_ENV=staging npm run build",
    "build:production": "cross-env REACT_APP_ENV=production npm run build",
    "build:dev": "webpack --config webpack.dev.js",
    "build:analyze": "webpack --config webpack.analyze.js",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:ci": "CI=true react-scripts test --coverage --watchAll=false --testResultsProcessor=jest-sonar-reporter",
    "test:debug": "react-scripts --inspect-brk test --runInBand --no-cache",
    "test:update": "react-scripts test --updateSnapshot",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:ci": "eslint src --ext .ts,.tsx --format=json --output-file=reports/eslint-report.json",
    "lint:check": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"public/**/*.{html,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"public/**/*.{html,json}\" \"*.{js,json,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "setup:folders": "node scripts/setup-folders.js",
    "setup:folders-sh": "chmod +x scripts/setup-folders.sh && ./scripts/setup-folders.sh",
    "setup:husky": "husky install",
    "setup:complete": "npm run setup:folders && npm run setup:husky && npm run format",
    "clean": "rimraf build node_modules/.cache",
    "clean:all": "rimraf build node_modules package-lock.json && npm install",
    "clean:build": "rimraf build && webpack --config webpack.prod.js",
    "clean:cache": "npm start -- --reset-cache",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:update:interactive": "npx npm-check-updates -i",
    "pre-commit": "lint-staged",
    "pre-push": "npm run type-check && npm run test:ci",
    "commit": "npx git-cz",
    "start:webpack": "webpack serve --config webpack.dev.js",
    "build:webpack": "webpack --config webpack.prod.js",
    "docker:build": "docker build -t enterprise-react-app .",
    "docker:run": "docker run -p 3000:80 enterprise-react-app",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up",
    "deploy:staging": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh staging",
    "deploy:production": "chmod +x scripts/deploy.sh && ./scripts/deploy.sh production",
    "backup": "chmod +x scripts/backup.sh && ./scripts/backup.sh",
    "analyze:bundle": "npm run build && npx webpack-bundle-analyzer build/static/js/*.js",
    "analyze:deps": "npx depcheck",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:component": "node scripts/generate-component.js",
    "i18n:extract": "i18next-scanner --config i18next-scanner.config.js",
    "i18n:validate": "node scripts/validate-translations.js",
    "postinstall": "husky install"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie <= 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check && npm run test:ci",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "chore",
          "ci",
          "build",
          "revert"
        ]
      ]
    }
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/reportWebVitals.ts",
      "!src/tests/**/*",
      "!src/mocks/**/*"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.(test|spec).{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2)$": "<rootDir>/src/tests/__mocks__/fileMock.js"
    }
  },
  "msw": {
    "workerDirectory": "public"
  },
  "packageManager": "npm@8.19.0"
}
