# Local Development Environment Overrides
# Copy this file to .env.local and customize as needed

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001/api
REACT_APP_API_TIMEOUT=5000

# Debug and Development
REACT_APP_DEBUG_MODE=true
REACT_APP_MOCK_API=true
REACT_APP_MOCK_DELAY=300

# DevTools
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_ENABLE_REACT_QUERY_DEVTOOLS=true

# Local Feature Testing
REACT_APP_FEATURE_NEW_DASHBOARD=true
REACT_APP_FEATURE_ANALYTICS=false
REACT_APP_FEATURE_BETA_FEATURES=true

# Local Services (Optional)
# REACT_APP_SENTRY_DSN=
# REACT_APP_POSTHOG_KEY=