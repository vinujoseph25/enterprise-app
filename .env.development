# Development Environment Configuration
REACT_APP_ENV=development
REACT_APP_API_BASE_URL=http://localhost:3001/api
REACT_APP_API_TIMEOUT=10000
REACT_APP_APP_NAME=Enterprise React App (Dev)
REACT_APP_VERSION=1.0.0

# Debug Settings
REACT_APP_LOG_LEVEL=debug
REACT_APP_DEBUG_MODE=true
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_ENABLE_REACT_QUERY_DEVTOOLS=true

# Feature Flags
REACT_APP_FEATURE_NEW_DASHBOARD=true
REACT_APP_FEATURE_ANALYTICS=false
REACT_APP_FEATURE_BETA_FEATURES=true

# Third-party Services (Development)
REACT_APP_SENTRY_DSN=
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=

# Mock API
REACT_APP_MOCK_API=true
REACT_APP_MOCK_DELAY=500

# Security
REACT_APP_CSP_ENABLED=false